            ],
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "84573461-c2e9-4eeb-8e9a-478734860b4a"
          },
          {
            "name": "Sourcing Spread Base %",
            "displayFolder": "Sourcing Spreads",
            "expression": "DIVIDE(SUM('Main'[ss_base]),SUM('Main'[bookings]))",
            "formatString": "0.0%;-0.0%;0.0%",
