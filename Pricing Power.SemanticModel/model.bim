            "lineageTag": "e4e064f2-9596-45de-a565-aaed342aef39"
          },
          {
            "name": "Bookings $ Prev. Month",
            "displayFolder": "Bookings",
            "expression": [
              "",
              "VAR CM = SELECTEDVALUE('Main'[month])",
              "VAR CY = SELECTEDVALUE('Main'[year])",
              "VAR PM = IF(CM=1,12,CM-1)",
              "VAR PY = IF(CM=1,CY-1,CY)",
              "RETURN CALCULATE(SUM('Main'[bookings]),'Main'[year]=PY,'Main'[month]=PM)"
            ],
            "formatString": "#,0.00",
            "lineageTag": "1a87fc06-67af-4264-9a05-e20db0eaa0fd"
          },
          {
            "name": "Mileage Cur. Month",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ],
            "displayFolder": "Mileage",
            "expression": "IF([Month Filter],SUM([mileage]),BLANK())",
            "formatString": "0",
            "lineageTag": "d521a3cd-fe70-4416-87ad-972adf7acd69"
          },
          {
            "name": "Mileage Prev. Month",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDecimal\":true}"
              }
            ],
            "displayFolder": "Mileage",
            "expression": [
              "",
              "VAR CM = SELECTEDVALUE('Main'[month])",
              "VAR CY = SELECTEDVALUE('Main'[year])",
              "VAR PM = IF(CM=1,12,CM-1)",
              "VAR PY = IF(CM=1,CY-1,CY)",
              "RETURN CALCULATE(SUM('Main'[mileage]),'Main'[year]=PY,'Main'[month]=PM)"
            ],
            "formatString": "0",
            "lineageTag": "94722fc6-6f8b-455e-a23a-a1e83b9d9a18"
          },
          {
            "name": "RPM",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "RPM",
            "expression": "DIVIDE(SUM('Main'[bookings]),SUM('Main'[mileage]))",
            "lineageTag": "e6a29905-0df3-4eab-a0af-99e7e4a0ef17"
          },
          {
            "name": "RPM Cur. Month",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "RPM",
            "expression": "IF([Month Filter],[RPM],BLANK())",
            "lineageTag": "2497bbab-bc08-4f09-8724-74025711c935"
          },
          {
            "name": "RPM Prev. Month",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "RPM",
            "expression": [
              "",
              "VAR CM = SELECTEDVALUE('Main'[month])",
              "VAR CY = SELECTEDVALUE('Main'[year])",
              "VAR PM = IF(CM=1,12,CM-1)",
              "VAR PY = IF(CM=1,CY-1,CY)",
              "RETURN CALCULATE([RPM],'Main'[year]=PY,'Main'[month]=PM)"
            ],
            "lineageTag": "ae96f107-44e9-4b6d-bab6-2521bb4a20f9"
          },
          {
            "name": "MoM",
            "displayFolder": "Growth Measures",
            "expression": [
              "",
              "VAR D = DIVIDE([Bookings $ Cur. Month],[Bookings $ Prev. Month])-1",
              "RETURN IF(D=-1,BLANK(),D)"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "f0a9ca49-e68c-4187-84d2-cc89f92c7b16"
          },
          {
            "name": "DVm",
            "displayFolder": "Growth Measures",
            "expression": [
              "",
              "VAR D = [DVr]",
              "RETURN IF(ISBLANK(D),BLANK(),IF(ABS(D)<0.002,0,D))"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "0dae48b2-3aa7-46f7-9935-8d4bbcc399a3"
          },
          {
            "name": "DPm",
            "displayFolder": "Growth Measures",
            "expression": [
              "",
              "VAR D = [DPr]",
              "RETURN IF(ISBLANK(D),BLANK(),IF(ABS(D)<0.002,0,D))"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "0455cd1f-6868-43fc-830f-2fe06b9619ce"
          },
          {
            "name": "Quadrant",
            "displayFolder": "Quadrants",
            "expression": [
              "",
              "IF(NOT([Month Filter]) || ISBLANK([MoM]) || [# Unique Lanes]>1,",
              "    BLANK(),",
              "    IF([DPm]>0,",
              "\t    IF([DVm]>0, \"1. Upgrade\", \"2. Strategic Price\"),",
              "\t    IF([DVm]<0, \"3. Downgrade\", \"4. Strategic Vol.\")",
              "    )",
              ")"
            ],
            "lineageTag": "3997525e-9ebb-4710-a28d-168ce460a9a7"
          },
          {
            "name": "# Loads (1. Upgrade)",
            "displayFolder": "Loads",
            "expression": "[# Loads (1a. Upgrade & Winning)]+[# Loads (1b. Upgrade & Losing)]",
            "formatString": "0",
            "lineageTag": "eaeb8ccc-8e0d-499f-b179-42c10704b72d"
          },
          {
            "name": "# Loads (2. St. Price)",
            "displayFolder": "Loads",
            "expression": "CALCULATE(SUM('Main'[loads]),FILTER(VALUES('Main'[lane_kma]),[Quadrant]=\"2. Strategic Price\"))",
            "formatString": "0",
            "lineageTag": "ff70e74d-616a-46df-a613-09f81e3560b4"
          },
          {
            "name": "# Loads (3. Downgrade)",
            "displayFolder": "Loads",
