          {
            "name": "KPI (Company-Wide)",
            "displayFolder": "KPIs",
            "expression": [
              "",
              "CALCULATE(",
              "    [KPI],",
              "    'Main'[sales_team]=\"Account Sales\" ||",
              "    'Main'[sales_team]=\"Enterprise Sales\",",
              "    ALLEXCEPT('Main',",
              "        'Main'[year],",
              "        'Main'[month]",
              "    )",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "5af05e29-8ce3-4dab-8f4b-8017aa9dbcaa"
          },
          {
            "name": "CI (Lanes) %",
            "displayFolder": "Auxiliary Metrics",
            "expression": [
              "",
              "VAR L = [# Lanes]",
              "VAR UL = [# Unique Lanes]",
              "RETURN (UL-L)/UL"
            ],
            "formatString": "0%;-0%;0%",
            "lineageTag": "3af722da-a02d-46e4-9f3d-55d02401384c"
          },
          {
            "name": "# Unique Shippers",
            "displayFolder": "Auxiliary Metrics",
            "expression": "DISTINCTCOUNT('Main'[shipper_name])",
            "formatString": "0",
            "lineageTag": "0f4e9c75-b192-4107-9534-5bec5bad86fd"
          },
          {
            "name": "# Unique Lanes",
            "displayFolder": "Auxiliary Metrics",
            "expression": "DISTINCTCOUNT('Main'[lane_kma])",
            "formatString": "0",
            "lineageTag": "c60dd57c-0758-4f5a-8954-9b0465de3853"
          },
          {
            "name": "Total Amount $",
            "displayFolder": "Buckets",
            "expression": [
              "",
              "SWITCH(",
              "    SUM(Amounts[index]),",
              "    1,SUM('Main'[bookings]),",
              "    2,SUM('Main'[ss_base]),",
              "    BLANK()",
              ")"
            ],
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "80cb9584-77fe-4d2c-b3f0-571f7a0ad425"
          },
          {
            "name": "CI (Amount $) %",
            "displayFolder": "Auxiliary Metrics",
            "expression": [
              "",
              "VAR T = [Total Amount $]",
              "VAR B = [0. KPI is blank (not incl'd in Total)]",
              "RETURN IF([Month Filter],T/(T+B),BLANK())"
            ],
            "formatString": "0%;-0%;0%",
            "lineageTag": "2c1332f9-ee79-41e9-a3fa-7be6c7c200b3"
          },
          {
            "name": "sanity_check_m",
            "displayFolder": "Auditing",
            "expression": "(1+[DPm])*(1+[DVm])-1-[MoM]",
            "formatString": "0.00",
            "lineageTag": "066d6ce2-9bf4-4c00-94ef-380c29f509f2"
          },
          {
            "name": "Quadrant Changed From Previous Month? (Y/N)",
            "displayFolder": "Quadrants",
            "expression": [
              "",
              "VAR CC = [Quadrant]",
              "VAR CP = [Quadrant Prev. Month]",
              "RETURN IF(ISBLANK(CC) || ISBLANK(CP),BLANK(),IF(CC=CP,\"N\",\"Y\"))"
            ],
            "lineageTag": "0259f9c7-ec7c-4713-a781-107643bda086"
          },
          {
            "name": "# Changes",
            "displayFolder": "Quadrants",
            "expression": [
              "",
              "VAR D = SUMX(",
              "    ADDCOLUMNS(",
              "        VALUES('Main'[year]),",
              "        \"x\",COUNTROWS(",
              "            FILTER(",
              "                VALUES('Main'[month]),",
              "                [Quadrant Changed From Previous Month? (Y/N)]=\"Y\"",
              "            )",
              "        )",
              "    ),",
              "    [x]",
              ")",
              "RETURN IF(ISBLANK([# Months]),",
              "    BLANK(),",
              "    IF(ISBLANK(D),0,D)",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "e1b5fbb8-703b-477f-b367-c5b9628ca751"
          },
          {
            "name": "# Months",
            "displayFolder": "Quadrants",
            "expression": [
              "",
              "IF([Month Filter],",
              "    BLANK(),",
              "    SUMX(",
              "        ADDCOLUMNS(",
              "            VALUES('Main'[year]),",
              "            \"x\",COUNTX(",
              "                ADDCOLUMNS(",
              "                    VALUES('Main'[month]),",
              "                    \"y\",[Quadrant]",
              "                ),",
              "                [y]",
              "            )",
              "        ),",
              "        [x]",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "63024ccd-37cc-4ac3-97b4-984b54b7e3b2"
          },
          {
            "name": "Quadrant Volatility %",
            "displayFolder": "Quadrants",
            "expression": "CALCULATE(DIVIDE([# Changes],[# Months]-1),ALLEXCEPT('Main','Main'[lane_kma],'Main'[equip_type],'Main'[quoting_method]))",
            "formatString": "0%;-0%;0%",
            "lineageTag": "4b3f183c-e8bc-4d77-a0dd-97788f7a646d"
          },
          {
            "name": "Month Filter",
            "displayFolder": "Auxiliary Metrics",
            "expression": "ISFILTERED('Main'[month])",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\"",
            "lineageTag": "d733d783-c529-42ea-a45c-1f437538f4b2"
          },
          {
            "name": "Span (# Months)",
            "displayFolder": "Quadrants",
            "expression": "CALCULATE([# Months],ALLEXCEPT('Main','Main'[lane_kma],'Main'[equip_type]))",
            "formatString": "0",
            "lineageTag": "481fa54c-8423-407a-8ca4-103c799d6808"
          },
          {
            "name": "KPI",
            "displayFolder": "KPIs",
            "expression": [
              "",
              "VAR K1A = [# Loads (1a. Upgrade & Winning)]",
              "VAR K1B = [# Loads (1b. Upgrade & Losing)]",
              "VAR K2  = [# Loads (2. St. Price)] ",
              "VAR K3  = [# Loads (3. Downgrade)]",
              "VAR K4  = [# Loads (4. St. Vol.)]",
              "RETURN",
              "(K1A*[Weight .1a]",
              "+K1B*[Weight .1b]",
              "+K2 *[Weight .2]",
              "+K3 *[Weight .3]",
              "+K4 *[Weight .4])/",
              "(K1A+K1B+K2+K3+K4)"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "fd03a9d9-611f-4b20-9e21-55fcfa4995e3"
          },
          {
            "name": "DVr",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "Growth Measures",
            "expression": [
              "",
              "VAR D = DIVIDE([Mileage Cur. Month],[Mileage Prev. Month])-1",
              "RETURN IF(D=-1,BLANK(),D)"
            ],
            "lineageTag": "f6acc10c-231c-4272-9f5b-ceaf2fa8a2b8"
          },
          {
            "name": "sanity_check_r",
            "displayFolder": "Auditing",
            "expression": "(1+[DPr])*(1+[DVr])-1-[MoM]",
            "formatString": "0.0000",
            "lineageTag": "616aac38-931f-4909-8e26-9413d1a003ef"
          },
          {
            "name": "Markup Over ECOH %",
            "displayFolder": "Markup Over ECOH",
            "expression": "CALCULATE(DIVIDE(SUM('Main'[markup_ecoh]),SUM('Main'[original_ecoh])),'Main'[original_ecoh]>=300)",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "3c2b9cc3-f23d-4145-805d-e55bd5a39152"
          },
          {
            "name": "Conversion %",
            "displayFolder": "Conversion",
            "expression": "MIN(DIVIDE(SUM('Main'[loads]),SUM(Quoting[quotes])),1)",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "a002023c-9b26-4e3f-b616-1b41101673e6"
          },
          {
            "name": "DPr",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "Growth Measures",
            "expression": [
              "",
              "VAR D = DIVIDE([RPM Cur. Month],[RPM Prev. Month])-1",
              "RETURN IF(D=-1,BLANK(),D)"
            ],
            "lineageTag": "a2ea241c-de90-4ae7-8390-769c43111749"
          },
          {
            "name": "Total # Loads",
            "displayFolder": "Total # of Loads",
            "expression": "SUMX(ADDCOLUMNS(VALUES('Main'[month]),\"x\",[# Loads]),[x])",
            "formatString": "0",
            "lineageTag": "0174e892-6dd7-4c46-b7cd-4a301cfaad63"
          },
          {
            "name": "Total # Loads (1. Upgrade)",
            "displayFolder": "Total # of Loads",
            "expression": "SUMX(ADDCOLUMNS(VALUES('Main'[month]),\"x\",[# Loads (1. Upgrade)]),[x])",
            "formatString": "0",
            "lineageTag": "89bfe63b-dc4f-4c10-82d6-e84d8d46a0c4"
          },
          {
            "name": "Total # Loads (2. Strategic Price)",
            "displayFolder": "Total # of Loads",
            "expression": "SUMX(ADDCOLUMNS(VALUES('Main'[month]),\"x\",[# Loads (2. St. Price)]),[x])",
            "formatString": "0",
            "lineageTag": "cceca340-017c-4377-935c-3ffc5e5e4d0a"
          },
          {
            "name": "Total # Loads (3. Downgrade)",
            "displayFolder": "Total # of Loads",
            "expression": "SUMX(ADDCOLUMNS(VALUES('Main'[month]),\"x\",[# Loads (3. Downgrade)]),[x])",
            "formatString": "0",
            "lineageTag": "ee6a1ad4-12a6-4508-9fa8-8c3528a679fa"
          },
          {
            "name": "Total # Loads (4. Strategic Vol.)",
            "displayFolder": "Total # of Loads",
            "expression": "SUMX(ADDCOLUMNS(VALUES('Main'[month]),\"x\",[# Loads (4. St. Vol.)]),[x])",
            "formatString": "0",
            "lineageTag": "0439c482-2375-4e8c-be13-09eb4325e2ec"
          },
          {
            "name": "Total # Lanes",
            "displayFolder": "Total # of Lanes",
            "expression": "SUMX(ADDCOLUMNS(VALUES('Main'[month]),\"x\",[# Lanes]),[x])",
            "formatString": "0",
            "lineageTag": "987c388e-7ead-4725-8a72-1a3e36421d84"
          },
          {
            "name": "Total # Lanes (4. Strategic Vol.)",
            "displayFolder": "Total # of Lanes",
            "expression": "SUMX(ADDCOLUMNS(VALUES('Main'[month]),\"x\",[# Lanes (4. St. Vol.)]),[x])",
            "formatString": "0",
            "lineageTag": "0c891aa8-76d0-4cf4-a044-f0127e46ade2"
          },
          {
            "name": "Total # Lanes (2. Strategic Price)",
            "displayFolder": "Total # of Lanes",
            "expression": "SUMX(ADDCOLUMNS(VALUES('Main'[month]),\"x\",[# Lanes (2. St. Price)]),[x])",
            "formatString": "0",
            "lineageTag": "c8c06c51-e806-44e0-8783-ce9f19d3e484"
          },
          {
            "name": "Total # Lanes (1. Upgrade)",
            "displayFolder": "Total # of Lanes",
            "expression": "SUMX(ADDCOLUMNS(VALUES('Main'[month]),\"x\",[# Lanes (1. Upgrade)]),[x])",
            "formatString": "0",
            "lineageTag": "f4324ea5-f536-49c4-8a62-7bb3f5d583b7"
          },
          {
            "name": "Total # Lanes (3. Downgrade)",
            "displayFolder": "Total # of Lanes",
            "expression": "SUMX(ADDCOLUMNS(VALUES('Main'[month]),\"x\",[# Lanes (3. Downgrade)]),[x])",
            "formatString": "0",
            "lineageTag": "89113cce-8eb0-4d8d-8151-ec0927ab7028"
          },
          {
            "name": "Quadrant Prev. Month",
            "displayFolder": "Quadrants",
            "expression": [
              "",
              "VAR CM = SELECTEDVALUE('Main'[month])",
              "VAR CY = SELECTEDVALUE('Main'[year])",
              "VAR PM = IF(CM=1,12,CM-1)",
              "VAR PY = IF(CM=1,CY-1,CY)",
              "RETURN CALCULATE([Quadrant],'Main'[month]=PM,'Main'[year]=PY)"
            ],
            "lineageTag": "cc71fe06-58bc-4ce6-8ec4-8c97a0beb9f0"
          },
          {
            "name": "Quadrant Next Month",
            "displayFolder": "Quadrants",
            "expression": [
              "",
              "VAR CM = SELECTEDVALUE('Main'[month])",
              "VAR CY = SELECTEDVALUE('Main'[year])",
              "VAR NM = IF(CM=12,1,CM+1)",
              "VAR NY = IF(CM=12,CY+1,CY)",
              "RETURN CALCULATE([Quadrant],'Main'[month]=NM,'Main'[year]=NY)"
            ],
            "lineageTag": "6e1f8876-5a2e-44a7-b087-ed92230f7e6b"
          },
          {
            "name": "# Unique Carriers (last 12 mo.)",
            "displayFolder": "Auxiliary Metrics",
            "expression": "IF([# Unique Lanes]=1,SUM(Carriers[no_carriers]),BLANK())",
            "formatString": "0",
            "lineageTag": "f662e5b0-cdad-4f54-ae57-09e1c2434163"
          },
          {
            "name": "%GT # Loads",
            "displayFolder": "Loads",
            "expression": [
              "",
              "[# Loads]/",
              "CALCULATE(",
              "    SUMX(",
              "        ADDCOLUMNS(",
              "            VALUES('Main'[equip_type]),",
              "            \"x\",[# Loads]",
              "        ),",
              "        [x]",
              "    ),",
              "    ALLEXCEPT('Main',",
              "        'Main'[year],",
              "        'Main'[month],",
              "        'Main'[sales_team],",
              "        'Main'[quoting_method]",
              "    )",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "4826952d-b84a-4e99-aee8-0ded85270be6"
          },
          {
            "name": "SSB % Cur. Month",
            "displayFolder": "Sourcing Spreads",
            "expression": "IF([Month Filter],[Sourcing Spread Base %],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "4c38ad83-c49a-4d3c-8384-f4319deacfca"
          },
          {
            "name": "SSB % Prev. Month",
            "displayFolder": "Sourcing Spreads",
            "expression": [
              "",
              "VAR CM = SELECTEDVALUE('Main'[month])",
              "VAR CY = SELECTEDVALUE('Main'[year])",
              "VAR PM = IF(CM=1,12,CM-1)",
              "VAR PY = IF(CM=1,CY-1,CY)",
              "RETURN CALCULATE([Sourcing Spread Base %],'Main'[year]=PY,'Main'[month]=PM)"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "542ebf94-6081-4492-b905-de713f3dda72"
          },
          {
            "name": "Lane Score",
            "displayFolder": "Sourcing Spreads",
            "expression": [
              "",
              "VAR PTh = 0.05",
              "VAR NTh = -0.03",
              "VAR CS = [SSB % Cur. Month]",
              "VAR PS = [SSB % Prev. Month]",
              "RETURN IF(ISBLANK(CS),",
              "    BLANK(),",
              "    IF(CS>PTh,",
              "        IF(PS>PTh,\"A\",\"B\"),",
              "        IF(CS<NTh,",
              "            IF(PS<NTh,\"F\",\"D\"),",
              "            \"C\"",
              "        )",
              "    )",
              ")"
            ],
            "lineageTag": "4319502e-8edd-4c91-bd78-e188256a9e6b"
          },
          {
            "name": "Conversion (last 12 mo.) %",
            "displayFolder": "Conversion",
            "expression": [
              "",
              "VAR D = MAX('Periods'[year-month])",
              "RETURN",
              "CALCULATE(",
              "    [Conversion %],",
              "    ALLEXCEPT(",
              "        'Main',",
              "        'Main'[lane_kma],",
              "        'Main'[equip_type]",
              "    ),",
              "    Main[year-month] >  D-100,",
              "    Main[year-month] <= D",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "b48e09c6-986a-4fde-a478-0cfd8789743a"
          },
          {
            "name": "%GT # Loads (Q. Method)",
            "displayFolder": "Loads",
            "expression": [
              "",
              "[# Loads]/",
              "CALCULATE(",
              "    SUMX(",
              "        ADDCOLUMNS(",
              "            VALUES('Main'[quoting_method]),",
              "            \"x\",[# Loads]",
              "        ),",
              "        [x]",
              "    ),",
              "    ALLEXCEPT('Main',",
              "        'Main'[year],",
              "        'Main'[month],",
              "        'Main'[sales_team],",
              "        'Main'[equip_type]",
              "    )",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "8b464a95-cb65-419b-ac98-3ddc90b0cea9"
          },
          {
            "name": "%GT # Loads (S. Team)",
            "displayFolder": "Loads",
            "expression": [
              "",
              "[# Loads]/",
              "CALCULATE(",
              "    SUMX(",
              "        ADDCOLUMNS(",
              "            VALUES('Main'[sales_team]),",
              "            \"x\",[# Loads]",
              "        ),",
              "        [x]",
              "    ),",
              "    ALLEXCEPT('Main',",
              "        'Main'[year],",
              "        'Main'[month],",
              "        'Main'[equip_type],",
              "        'Main'[quoting_method]",
              "    ),",
              "    Main[sales_team]=\"Account Sales\"||",
              "    Main[sales_team]=\"Enterprise Sales\"",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "4c4aad31-0e7e-4087-a1cb-1d2d95794695"
          }
        ],
        "partitions": [
          {
            "name": "Main",
            "mode": "import",
            "queryGroup": "Consolidated",
            "source": {
              "expression": [
                "let",
                "    Source = Parquet.Document(File.Contents(DataFolder & \"Main.parquet\")),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source, {{\"equip_type\", type text}, {\"lane_kma\", type text}, {\"year\", Int64.Type}, {\"month\", Int64.Type}, {\"bookings\", type number}, {\"mileage\", type number}, {\"loads\", Int64.Type}, {\"ss_base\", type number}, {\"markup_ecoh\", type number}, {\"original_ecoh\", type number}, {\"kma_origin_prefix\", type text}, {\"kma_destiny_prefix\", type text}, {\"extra_charges\", type number}, {\"sk_shipper\", Int64.Type}, {\"quoting_method\", type text}, {\"lane\", type text}, {\"lane_origin\", type text}, {\"lane_destiny\", type text}})",
                "in",
                "    #\"Changed Type\""
              ],
              "type": "m"
            }
          }
        ]
      },
