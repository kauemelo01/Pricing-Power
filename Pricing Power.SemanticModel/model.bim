            "formatString": "0",
            "lineageTag": "fc178258-861c-45bd-9395-1038c04f349a"
          },
          {
            "name": "# Loads (4. St. Vol.)",
            "displayFolder": "Loads",
            "expression": "CALCULATE(SUM('Main'[loads]),FILTER(VALUES('Main'[lane_kma]),[Quadrant]=\"4. Strategic Vol.\"))",
            "formatString": "0",
            "lineageTag": "a33a9df2-249f-40d7-95d7-c398b64f14b7"
          },
          {
            "name": "# Lanes (1. Upgrade)",
            "displayFolder": "Lanes",
            "expression": "COUNTROWS(FILTER(VALUES('Main'[lane_kma]),[Quadrant]=\"1. Upgrade\"))",
            "formatString": "0",
            "lineageTag": "a776c9e5-24d3-4f6a-a3b5-da06024da9ff"
          },
          {
            "name": "# Lanes (2. St. Price)",
            "displayFolder": "Lanes",
            "expression": "COUNTROWS(FILTER(VALUES('Main'[lane_kma]),[Quadrant]=\"2. Strategic Price\"))",
            "formatString": "0",
