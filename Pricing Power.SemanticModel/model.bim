              "        VALUES('Main'[shipper_name]),",
              "        [KPI (Shipper Specific)]>=[Threshold .1] && ",
              "        [KPI (Shipper Specific)]<[Threshold .2]",
              "    )",
              ")"
            ],
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "08a7953f-6243-4540-a76a-39042af1471f"
          },
          {
