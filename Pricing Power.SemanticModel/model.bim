              ")"
            ],
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "c3ce9b8c-df91-4afb-8784-90b3819194c9"
          },
          {
            "name": "5. KPI at max.",
            "displayFolder": "Buckets",
            "expression": [
