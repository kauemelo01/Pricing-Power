          },
          {
            "name": "# Lanes (3. Downgrade)",
            "displayFolder": "Lanes",
            "expression": "COUNTROWS(FILTER(VALUES('Main'[lane_kma]),[Quadrant]=\"3. Downgrade\"))",
            "formatString": "0",
            "lineageTag": "9d1d5ff2-8c92-4f85-a4a6-5e72d590adb0"
          },
          {
            "name": "# Lanes (4. St. Vol.)",
            "displayFolder": "Lanes",
            "expression": "COUNTROWS(FILTER(VALUES('Main'[lane_kma]),[Quadrant]=\"4. Strategic Vol.\"))",
            "formatString": "0",
            "lineageTag": "407f1437-eb15-4072-9664-1b56b7ae3edc"
          },
          {
            "name": "# Loads",
            "displayFolder": "Loads",
            "expression": "CALCULATE(SUM('Main'[loads]),FILTER(VALUES('Main'[lane_kma]),[Quadrant]<>BLANK()))",
            "formatString": "0",
            "lineageTag": "1a7f7262-1477-480b-a47c-42362926ee90"
          },
          {
            "name": "# Lanes",
            "displayFolder": "Lanes",
            "expression": "COUNTX(ADDCOLUMNS(VALUES('Main'[lane_kma]),\"x\",[Quadrant]),[x])",
            "formatString": "0",
            "lineageTag": "92fd4970-921d-4414-ae3f-72b7fbdb8580"
          },
          {
            "name": "KPI (Shipper Specific)",
            "displayFolder": "KPIs",
            "expression": "IF([# Unique Shippers]=1,[KPI],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "38eff1e0-6841-4108-982a-9c89cb97bf0b"
          },
          {
            "name": "Pricing KPI",
            "displayFolder": "KPIs",
            "expression": [
              "",
              "CALCULATE(",
              "    [KPI],",
              "    ALLEXCEPT('Main',",
              "        'Main'[year],",
              "        'Main'[month],",
              "        'Main'[equip_type],",
              "        'Main'[sales_team],",
              "        'Main'[quoting_method]",
              "    )",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "14387002-085d-476d-ac2a-ef13eb2918c9"
          },
          {
            "name": "# Shippers (1. KPI less than 0%)",
            "displayFolder": "Shippers",
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        VALUES('Main'[shipper_name]),",
              "        [KPI (Shipper Specific)]<[Threshold .1]",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "3d0d98ca-5916-4960-a170-e440f946ce36"
          },
          {
            "name": "# Shippers (2. KPI between 0% and 100%)",
            "displayFolder": "Shippers",
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        VALUES('Main'[shipper_name]),",
              "        [KPI (Shipper Specific)]>=[Threshold .1] && ",
              "        [KPI (Shipper Specific)]<[Threshold .2]",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "ca9de443-1f7b-440e-972b-cccb135e4799"
          },
          {
            "name": "# Shippers (3. KPI at 100%)",
            "displayFolder": "Shippers",
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        VALUES('Main'[shipper_name]),",
              "        [KPI (Shipper Specific)]=[Threshold .2]",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "89fddb34-ed15-4baa-9df7-7f9553ff17be"
          },
          {
            "name": "# Shippers (4. KPI between 100% and max.)",
            "displayFolder": "Shippers",
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        VALUES('Main'[shipper_name]),",
              "        [KPI (Shipper Specific)]>[Threshold .2] && ",
              "        [KPI (Shipper Specific)]<=[Threshold .3]",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "62922508-ce26-43f1-b01b-20554c1d887e"
          },
          {
            "name": "# Shippers (5. KPI at max.)",
            "displayFolder": "Shippers",
            "expression": [
              "",
              "COUNTROWS(",
              "    FILTER(",
              "        VALUES('Main'[shipper_name]),",
              "        [KPI (Shipper Specific)]>[Threshold .3]",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "e48bbfc5-ceed-4c6a-9818-2643bb8cf365"
          },
          {
            "name": "1. KPI less than 0%",
            "displayFolder": "Buckets",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Amount $],",
              "    FILTER(",
              "        VALUES('Main'[shipper_name]),",
              "        [KPI (Shipper Specific)]<[Threshold .1]",
              "    )",
              ")"
            ],
